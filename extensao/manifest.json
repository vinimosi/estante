{
  "manifest_version": 3,
  "name": "Estante - Leitura",
  "version": "1.3.5",
  "description": "Avisa a Estante, no seu computador, qual capítulo você abriu nos seus sites de leitura. Não envia nada para a internet.",
  "permissions": ["scripting", "storage", "alarms", "notifications", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "*://comix.to/*", "*://*.comix.to/*",
    "*://comix.ws/*", "*://*.comix.ws/*",
    "*://asurascans.com/*", "*://*.asurascans.com/*",
    "*://demonicscans.org/*", "*://*.demonicscans.org/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Estante - Leitura",
    "default_popup": "popup.html",
    "default_icon": { "16": "icone16.png", "32": "icone32.png", "48": "icone48.png" }
  },
  "icons": { "16": "icone16.png", "32": "icone32.png", "48": "icone48.png", "128": "icone128.png" }
}
